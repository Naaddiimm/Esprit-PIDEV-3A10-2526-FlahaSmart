<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>
<?import javafx.scene.shape.*?>
<?import javafx.geometry.Insets?>
<?import de.jensd.fx.glyphs.fontawesome.FontAwesomeIconView?>

<BorderPane xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="controllers.Dashbord.DashboardAgriculteurController"
            stylesheets="@/css/agriculteur.css"
            styleClass="root-pane"
            prefHeight="768" prefWidth="1280">

    <!-- ==============================================
         SIDEBAR GAUCHE - Navigation premium
         ============================================== -->
    <left>
        <VBox styleClass="sidebar" prefWidth="280" spacing="0">
            <!-- Logo avec effet glassmorphism -->
            <HBox styleClass="sidebar-header" alignment="CENTER_LEFT" spacing="14">
                <padding><Insets top="28" bottom="28" left="24" right="24"/></padding>
                <StackPane styleClass="logo-glow">
                    <Circle radius="24" styleClass="logo-circle"/>
                    <FontAwesomeIconView glyphName="LEAF" size="22" styleClass="logo-icon"/>
                </StackPane>
                <VBox spacing="4">
                    <Text text="FlahaSmart" styleClass="logo-text"/>
                    <Text text="Espace Agriculteur" styleClass="logo-badge"/>
                </VBox>
            </HBox>

            <Separator styleClass="divider-gradient"/>

            <!-- Profil utilisateur avec effet hover -->
            <HBox styleClass="user-profile" alignment="CENTER_LEFT" spacing="14">
                <padding><Insets top="20" bottom="20" left="24" right="24"/></padding>
                <StackPane>
                    <Circle radius="24" styleClass="avatar-glow"/>
                    <Circle radius="22" styleClass="avatar-bg"/>
                    <FontAwesomeIconView glyphName="USER" size="20" styleClass="avatar-icon"/>
                </StackPane>
                <VBox spacing="4">
                    <Label fx:id="welcomeLabel" text="Ahmed Ben Ali" styleClass="user-name"/>
                    <HBox spacing="6" alignment="CENTER_LEFT">
                        <FontAwesomeIconView glyphName="STAR" size="10" styleClass="premium-star"/>
                        <Label text="Compte Premium" styleClass="user-plan"/>
                    </HBox>
                </VBox>
            </HBox>

            <Separator styleClass="divider-gradient"/>

            <!-- Menu principal avec animations -->
            <VBox styleClass="nav-menu" spacing="4" VBox.vgrow="ALWAYS">
                <padding><Insets top="20" bottom="20" left="20" right="20"/></padding>

                <Label text="TABLEAU DE BORD" styleClass="nav-section"/>

                <Button styleClass="nav-item, active" maxWidth="Infinity">
                    <graphic><FontAwesomeIconView glyphName="HOME" size="16" styleClass="nav-icon"/></graphic>
                    <text>Dashboard</text>
                </Button>

                <Button styleClass="nav-item" maxWidth="Infinity">
                    <graphic><FontAwesomeIconView glyphName="BAR_CHART" size="16" styleClass="nav-icon"/></graphic>
                    <text>Statistiques</text>
                </Button>

                <Label text="GESTION DES OPÉRATIONS" styleClass="nav-section"/>

                <!-- Opérations -->
                <Button styleClass="nav-item" maxWidth="Infinity">
                    <graphic><FontAwesomeIconView glyphName="PLUS_CIRCLE" size="16" styleClass="nav-icon"/></graphic>
                    <text>Ajouter opération</text>
                </Button>

                <Button styleClass="nav-item" maxWidth="Infinity">
                    <graphic><FontAwesomeIconView glyphName="LIST_ALT" size="16" styleClass="nav-icon"/></graphic>
                    <text>Liste opérations</text>
                    <graphic><HBox alignment="CENTER_RIGHT"><Label text="12" styleClass="nav-badge"/></HBox></graphic>
                </Button>

                <Button styleClass="nav-item" maxWidth="Infinity">
                    <graphic><FontAwesomeIconView glyphName="PLUS_SQUARE_ALT" size="16" styleClass="nav-icon"/></graphic>
                    <text>Ajouter équipement</text>
                </Button>

                <Button styleClass="nav-item" maxWidth="Infinity">
                    <graphic><FontAwesomeIconView glyphName="CUBES" size="16" styleClass="nav-icon"/></graphic>
                    <text>Liste équipements</text>
                    <graphic><HBox alignment="CENTER_RIGHT"><Label text="8" styleClass="nav-badge"/></HBox></graphic>
                </Button>

                <Label text="OUTILS AGRICOLES" styleClass="nav-section"/>

                <Button styleClass="nav-item" maxWidth="Infinity">
                    <graphic><FontAwesomeIconView glyphName="CLOUD" size="16" styleClass="nav-icon"/></graphic>
                    <text>Météo</text>
                </Button>

                <Button styleClass="nav-item, premium-item" maxWidth="Infinity">
                    <graphic><FontAwesomeIconView glyphName="COMMENT" size="16" styleClass="nav-icon"/></graphic>
                    <text>AgriBot</text>
                    <graphic><HBox alignment="CENTER_RIGHT"><Label text="Nouveau" styleClass="nav-badge-success"/></HBox></graphic>
                </Button>

                <Button styleClass="nav-item" maxWidth="Infinity">
                    <graphic><FontAwesomeIconView glyphName="MEDKIT" size="16" styleClass="nav-icon"/></graphic>
                    <text>Analyse Maladie</text>
                </Button>

                <Button styleClass="nav-item" maxWidth="Infinity">
                    <graphic><FontAwesomeIconView glyphName="TINT" size="16" styleClass="nav-icon"/></graphic>
                    <text>Irrigation</text>
                </Button>

                <Button styleClass="nav-item" maxWidth="Infinity">
                    <graphic><FontAwesomeIconView glyphName="REFRESH" size="16" styleClass="nav-icon"/></graphic>
                    <text>Rotation Cultures</text>
                </Button>

                <Region VBox.vgrow="ALWAYS"/>

                <Separator styleClass="divider-gradient"/>

                <Button styleClass="nav-item" maxWidth="Infinity">
                    <graphic><FontAwesomeIconView glyphName="COG" size="16" styleClass="nav-icon"/></graphic>
                    <text>Paramètres</text>
                </Button>

                <Button styleClass="nav-item, logout" maxWidth="Infinity">
                    <graphic><FontAwesomeIconView glyphName="SIGN_OUT" size="16" styleClass="nav-icon"/></graphic>
                    <text>Déconnexion</text>
                </Button>
            </VBox>
        </VBox>
    </left>

    <!-- ==============================================
         CONTENU PRINCIPAL - Design moderne
         ============================================== -->
    <center>
        <VBox styleClass="main-container" spacing="0">

            <!-- Top bar avec effets de verre -->
            <HBox styleClass="topbar-glass" alignment="CENTER_LEFT" spacing="24">
                <padding><Insets top="16" bottom="16" left="28" right="28"/></padding>

                <VBox spacing="4" HBox.hgrow="ALWAYS">
                    <Text text="Dashboard" styleClass="page-title"/>
                    <Text text="Gestion intelligente de votre exploitation" styleClass="page-subtitle"/>
                </VBox>

                <!-- Recherche améliorée -->
                <HBox styleClass="search-glass" alignment="CENTER_LEFT" spacing="12">
                    <FontAwesomeIconView glyphName="SEARCH" size="14" styleClass="search-icon"/>
                    <TextField promptText="Rechercher une opération..." styleClass="search-input" prefWidth="260"/>
                    <HBox styleClass="search-shortcut">
                        <Label text="⌘ K"/>
                    </HBox>
                </HBox>

                <!-- Notifications avec pulse -->
                <StackPane styleClass="notification-pulse">
                    <FontAwesomeIconView glyphName="BELL" size="18" styleClass="icon-btn"/>
                    <Label text="5" styleClass="notification-badge"/>
                </StackPane>

                <!-- Avatar -->
                <StackPane styleClass="avatar-modern">
                    <Circle radius="22" styleClass="avatar-ring"/>
                    <Circle radius="20" styleClass="avatar-fill"/>
                    <FontAwesomeIconView glyphName="USER" size="18" styleClass="avatar-icon-modern"/>
                </StackPane>
            </HBox>

            <!-- Zone de contenu avec scroll -->
            <ScrollPane fitToWidth="true" styleClass="content-scroll-modern" VBox.vgrow="ALWAYS">
                <HBox spacing="24">
                    <!-- Contenu principal -->
                    <VBox spacing="24" styleClass="content-wrapper-modern" HBox.hgrow="ALWAYS">
                        <padding><Insets top="24" bottom="24" left="28" right="0"/></padding>

                        <!-- KPI Cards modernes -->
                        <GridPane hgap="18" vgap="18">
                            <columnConstraints>
                                <ColumnConstraints hgrow="ALWAYS" percentWidth="25"/>
                                <ColumnConstraints hgrow="ALWAYS" percentWidth="25"/>
                                <ColumnConstraints hgrow="ALWAYS" percentWidth="25"/>
                                <ColumnConstraints hgrow="ALWAYS" percentWidth="25"/>
                            </columnConstraints>

                            <!-- Carte 1 : Opérations -->
                            <VBox styleClass="kpi-card-modern, gradient-green" spacing="14" GridPane.columnIndex="0">
                                <HBox alignment="CENTER_LEFT" spacing="16">
                                    <StackPane styleClass="kpi-icon-container">
                                        <Circle radius="24" styleClass="kpi-icon-bg"/>
                                        <FontAwesomeIconView glyphName="TASKS" size="22" styleClass="kpi-icon-white"/>
                                    </StackPane>
                                    <VBox spacing="4">
                                        <Label text="Opérations" styleClass="kpi-label-modern"/>
                                        <Label text="24" styleClass="kpi-value-modern"/>
                                    </VBox>
                                </HBox>
                                <HBox alignment="CENTER_LEFT" spacing="8">
                                    <FontAwesomeIconView glyphName="ARROW_UP" size="12" styleClass="trend-up-modern"/>
                                    <Label text="+12% cette semaine" styleClass="kpi-trend-modern"/>
                                </HBox>
                            </VBox>

                            <!-- Carte 2 : Équipements -->
                            <VBox styleClass="kpi-card-modern, gradient-blue" spacing="14" GridPane.columnIndex="1">
                                <HBox alignment="CENTER_LEFT" spacing="16">
                                    <StackPane styleClass="kpi-icon-container">
                                        <Circle radius="24" styleClass="kpi-icon-bg"/>
                                        <FontAwesomeIconView glyphName="CUBES" size="22" styleClass="kpi-icon-white"/>
                                    </StackPane>
                                    <VBox spacing="4">
                                        <Label text="Équipements" styleClass="kpi-label-modern"/>
                                        <Label text="18" styleClass="kpi-value-modern"/>
                                    </VBox>
                                </HBox>
                                <HBox alignment="CENTER_LEFT" spacing="8">
                                    <FontAwesomeIconView glyphName="ARROW_UP" size="12" styleClass="trend-up-modern"/>
                                    <Label text="+4 actifs" styleClass="kpi-trend-modern"/>
                                </HBox>
                            </VBox>

                            <!-- Carte 3 : Analyses -->
                            <VBox styleClass="kpi-card-modern, gradient-orange" spacing="14" GridPane.columnIndex="2">
                                <HBox alignment="CENTER_LEFT" spacing="16">
                                    <StackPane styleClass="kpi-icon-container">
                                        <Circle radius="24" styleClass="kpi-icon-bg"/>
                                        <FontAwesomeIconView glyphName="MEDKIT" size="22" styleClass="kpi-icon-white"/>
                                    </StackPane>
                                    <VBox spacing="4">
                                        <Label text="Analyses" styleClass="kpi-label-modern"/>
                                        <Label text="8" styleClass="kpi-value-modern"/>
                                    </VBox>
                                </HBox>
                                <HBox alignment="CENTER_LEFT" spacing="8">
                                    <FontAwesomeIconView glyphName="EXCLAMATION_TRIANGLE" size="12" styleClass="trend-warning-modern"/>
                                    <Label text="2 alertes" styleClass="kpi-trend-modern, warning"/>
                                </HBox>
                            </VBox>

                            <!-- Carte 4 : Rotations -->
                            <VBox styleClass="kpi-card-modern, gradient-purple" spacing="14" GridPane.columnIndex="3">
                                <HBox alignment="CENTER_LEFT" spacing="16">
                                    <StackPane styleClass="kpi-icon-container">
                                        <Circle radius="24" styleClass="kpi-icon-bg"/>
                                        <FontAwesomeIconView glyphName="REFRESH" size="22" styleClass="kpi-icon-white"/>
                                    </StackPane>
                                    <VBox spacing="4">
                                        <Label text="Rotations" styleClass="kpi-label-modern"/>
                                        <Label text="5" styleClass="kpi-value-modern"/>
                                    </VBox>
                                </HBox>
                                <HBox alignment="CENTER_LEFT" spacing="8">
                                    <FontAwesomeIconView glyphName="CALENDAR" size="12" styleClass="trend-neutral-modern"/>
                                    <Label text="3 ce mois" styleClass="kpi-trend-modern"/>
                                </HBox>
                            </VBox>
                        </GridPane>

                        <!-- Actions rapides -->
                        <HBox spacing="14">
                            <Button styleClass="action-btn, primary" maxWidth="Infinity" HBox.hgrow="ALWAYS">
                                <graphic><FontAwesomeIconView glyphName="PLUS_CIRCLE" size="14"/></graphic>
                                <text>Nouvelle opération</text>
                            </Button>
                            <Button styleClass="action-btn, secondary" maxWidth="Infinity" HBox.hgrow="ALWAYS">
                                <graphic><FontAwesomeIconView glyphName="CUBES" size="14"/></graphic>
                                <text>Ajouter équipement</text>
                            </Button>
                            <Button styleClass="action-btn, accent" maxWidth="Infinity" HBox.hgrow="ALWAYS">
                                <graphic><FontAwesomeIconView glyphName="MEDKIT" size="14"/></graphic>
                                <text>Analyse rapide</text>
                            </Button>
                        </HBox>

                        <!-- Opérations récentes -->
                        <VBox styleClass="card-modern" spacing="18">
                            <HBox alignment="CENTER_LEFT">
                                <VBox spacing="4" HBox.hgrow="ALWAYS">
                                    <Label text="Opérations en cours" styleClass="card-title-modern"/>
                                    <Label text="12 opérations cette semaine" styleClass="card-subtitle-modern"/>
                                </VBox>
                                <Button text="Voir tout →" styleClass="btn-link-modern"/>
                            </HBox>

                            <VBox spacing="12">
                                <HBox styleClass="operation-item" spacing="16" alignment="CENTER_LEFT">
                                    <StackPane styleClass="operation-icon, planting">
                                        <FontAwesomeIconView glyphName="LEAF" size="16"/>
                                    </StackPane>
                                    <VBox spacing="4" HBox.hgrow="ALWAYS">
                                        <Label text="Semis Blé dur" styleClass="operation-title"/>
                                        <Label text="Parcelle P-001 · Aujourd'hui 08:00" styleClass="operation-meta"/>
                                    </VBox>
                                    <Label text="En cours" styleClass="status-badge-modern, success"/>
                                </HBox>

                                <HBox styleClass="operation-item" spacing="16" alignment="CENTER_LEFT">
                                    <StackPane styleClass="operation-icon, irrigation">
                                        <FontAwesomeIconView glyphName="TINT" size="16"/>
                                    </StackPane>
                                    <VBox spacing="4" HBox.hgrow="ALWAYS">
                                        <Label text="Irrigation goutte-à-goutte" styleClass="operation-title"/>
                                        <Label text="Parcelle P-002 · Dans 2h" styleClass="operation-meta"/>
                                    </VBox>
                                    <Label text="Programmée" styleClass="status-badge-modern, info"/>
                                </HBox>

                                <HBox styleClass="operation-item" spacing="16" alignment="CENTER_LEFT">
                                    <StackPane styleClass="operation-icon, harvest">
                                        <FontAwesomeIconView glyphName="SHOPPING_BASKET" size="16"/>
                                    </StackPane>
                                    <VBox spacing="4" HBox.hgrow="ALWAYS">
                                        <Label text="Récolte Tomates" styleClass="operation-title"/>
                                        <Label text="Parcelle P-003 · Demain" styleClass="operation-meta"/>
                                    </VBox>
                                    <Label text="Planifiée" styleClass="status-badge-modern, warning"/>
                                </HBox>
                            </VBox>
                        </VBox>

                        <!-- Équipements et Météo -->
                        <HBox spacing="18">
                            <VBox styleClass="card-modern" spacing="16" HBox.hgrow="ALWAYS">
                                <HBox alignment="CENTER_LEFT">
                                    <Label text="Équipements actifs" styleClass="card-title-modern"/>
                                    <Region HBox.hgrow="ALWAYS"/>
                                    <Button text="Gérer" styleClass="btn-link-modern"/>
                                </HBox>

                                <VBox spacing="14">
                                    <HBox styleClass="equipment-modern" spacing="14" alignment="CENTER_LEFT">
                                        <StackPane styleClass="equipment-icon-modern, green">
                                            <FontAwesomeIconView glyphName="WRENCH" size="14"/>
                                        </StackPane>
                                        <VBox spacing="2" HBox.hgrow="ALWAYS">
                                            <Label text="Tracteur John Deere" styleClass="equipment-name-modern"/>
                                            <Label text="En fonctionnement · Parcelle Nord" styleClass="equipment-status-modern"/>
                                        </VBox>
                                        <FontAwesomeIconView glyphName="CHECK_CIRCLE" size="16" styleClass="status-online"/>
                                    </HBox>

                                    <HBox styleClass="equipment-modern" spacing="14" alignment="CENTER_LEFT">
                                        <StackPane styleClass="equipment-icon-modern, blue">
                                            <FontAwesomeIconView glyphName="TINT" size="14"/>
                                        </StackPane>
                                        <VBox spacing="2" HBox.hgrow="ALWAYS">
                                            <Label text="Système irrigation" styleClass="equipment-name-modern"/>
                                            <Label text="Actif · Parcelle Sud" styleClass="equipment-status-modern"/>
                                        </VBox>
                                        <FontAwesomeIconView glyphName="CHECK_CIRCLE" size="16" styleClass="status-online"/>
                                    </HBox>

                                    <HBox styleClass="equipment-modern" spacing="14" alignment="CENTER_LEFT">
                                        <StackPane styleClass="equipment-icon-modern, orange">
                                            <FontAwesomeIconView glyphName="WRENCH" size="14"/>
                                        </StackPane>
                                        <VBox spacing="2" HBox.hgrow="ALWAYS">
                                            <Label text="Pulvérisateur" styleClass="equipment-name-modern"/>
                                            <Label text="Maintenance programmée" styleClass="equipment-status-modern"/>
                                        </VBox>
                                        <FontAwesomeIconView glyphName="EXCLAMATION_TRIANGLE" size="16" styleClass="status-maintenance"/>
                                    </HBox>
                                </VBox>
                            </VBox>

                            <!-- Météo widget moderne -->
                            <VBox styleClass="weather-card-modern" spacing="16" prefWidth="240">
                                <HBox alignment="CENTER_LEFT">
                                    <FontAwesomeIconView glyphName="CLOUD" size="18" styleClass="weather-title-icon"/>
                                    <Label text="Météo du jour" styleClass="card-title-modern" HBox.hgrow="ALWAYS"/>
                                    <FontAwesomeIconView glyphName="REFRESH" size="12" styleClass="weather-refresh"/>
                                </HBox>

                                <HBox alignment="CENTER" spacing="20">
                                    <FontAwesomeIconView glyphName="SUN_ALT" size="48" styleClass="weather-icon-main"/>
                                    <VBox alignment="CENTER" spacing="4">
                                        <Label text="24°C" styleClass="weather-temp-modern"/>
                                        <Label text="Ressenti 26°C" styleClass="weather-feels"/>
                                    </VBox>
                                </HBox>

                                <GridPane hgap="12" vgap="12">
                                    <HBox spacing="8" alignment="CENTER_LEFT" GridPane.columnIndex="0" GridPane.rowIndex="0">
                                        <FontAwesomeIconView glyphName="TINT" size="12" styleClass="weather-detail-icon-modern"/>
                                        <Label text="65%" styleClass="weather-detail-value-modern"/>
                                    </HBox>
                                    <HBox spacing="8" alignment="CENTER_LEFT" GridPane.columnIndex="1" GridPane.rowIndex="0">
                                        <FontAwesomeIconView glyphName="FLAG" size="12" styleClass="weather-detail-icon-modern"/>
                                        <Label text="18 km/h" styleClass="weather-detail-value-modern"/>
                                    </HBox>
                                </GridPane>
                            </VBox>
                        </HBox>

                        <!-- Analyse Maladie et Rotation -->
                        <HBox spacing="18">
                            <VBox styleClass="card-modern" spacing="16" HBox.hgrow="ALWAYS">
                                <HBox alignment="CENTER_LEFT">
                                    <Label text="Analyse Maladie" styleClass="card-title-modern"/>
                                    <Region HBox.hgrow="ALWAYS"/>
                                    <Button text="Voir détails" styleClass="btn-link-modern"/>
                                </HBox>

                                <HBox spacing="24" alignment="CENTER">
                                    <VBox alignment="CENTER" spacing="8">
                                        <StackPane styleClass="analysis-ring, warning">
                                            <Circle radius="32" styleClass="ring-bg"/>
                                            <Label text="2" styleClass="ring-number"/>
                                        </StackPane>
                                        <Label text="Parcelles à risque" styleClass="analysis-label, warning"/>
                                        <Label text="P-002, P-004" styleClass="analysis-parcels"/>
                                    </VBox>
                                    <VBox alignment="CENTER" spacing="8">
                                        <StackPane styleClass="analysis-ring, success">
                                            <Circle radius="32" styleClass="ring-bg"/>
                                            <Label text="6" styleClass="ring-number"/>
                                        </StackPane>
                                        <Label text="Parcelles saines" styleClass="analysis-label, success"/>
                                        <Label text="Dernière analyse: hier" styleClass="analysis-parcels"/>
                                    </VBox>
                                </HBox>
                            </VBox>

                            <VBox styleClass="card-modern" spacing="16" HBox.hgrow="ALWAYS">
                                <HBox alignment="CENTER_LEFT">
                                    <Label text="Rotation Cultures" styleClass="card-title-modern"/>
                                    <Region HBox.hgrow="ALWAYS"/>
                                    <Button text="Planifier" styleClass="btn-link-modern"/>
                                </HBox>

                                <VBox spacing="14">
                                    <HBox alignment="CENTER_LEFT" spacing="12">
                                        <Label text="P-001" styleClass="parcel-tag"/>
                                        <ProgressBar progress="0.7" prefWidth="140" styleClass="rotation-progress-modern"/>
                                        <Label text="Blé → Maïs" styleClass="rotation-crops-modern"/>
                                    </HBox>
                                    <HBox alignment="CENTER_LEFT" spacing="12">
                                        <Label text="P-002" styleClass="parcel-tag"/>
                                        <ProgressBar progress="0.3" prefWidth="140" styleClass="rotation-progress-modern"/>
                                        <Label text="Tomate → Haricot" styleClass="rotation-crops-modern"/>
                                    </HBox>
                                    <HBox alignment="CENTER_LEFT" spacing="12">
                                        <Label text="P-003" styleClass="parcel-tag"/>
                                        <ProgressBar progress="0.9" prefWidth="140" styleClass="rotation-progress-modern"/>
                                        <Label text="Olive → Olive" styleClass="rotation-crops-modern"/>
                                    </HBox>
                                </VBox>
                            </VBox>
                        </HBox>
                    </VBox>

                    <!-- ==============================================
                         CHATBOT AGRICULTEUR - Design ultra-moderne
                         ============================================== -->
                    <VBox styleClass="chatbot-panel-modern" prefWidth="340" spacing="0">
                        <!-- Header avec gradient -->
                        <VBox styleClass="chatbot-header-modern" spacing="14">
                            <padding><Insets top="24" bottom="20" left="20" right="20"/></padding>

                            <HBox alignment="CENTER_LEFT" spacing="14">
                                <StackPane styleClass="chatbot-avatar-modern">
                                    <Circle radius="24" styleClass="avatar-pulse"/>
                                    <FontAwesomeIconView glyphName="COMMENT" size="22" styleClass="chatbot-avatar-icon"/>
                                </StackPane>
                                <VBox spacing="4">
                                    <Label text="AgriBot" styleClass="chatbot-title-modern"/>
                                    <Label text="Assistant IA · En ligne" styleClass="chatbot-status"/>
                                </VBox>
                                <Region HBox.hgrow="ALWAYS"/>
                                <FontAwesomeIconView glyphName="MINUS" size="14" styleClass="chatbot-action-modern"/>
                                <FontAwesomeIconView glyphName="CLOSE" size="14" styleClass="chatbot-action-modern"/>
                            </HBox>

                            <!-- Barre de statut -->
                            <HBox styleClass="ai-status" alignment="CENTER_LEFT" spacing="8">
                                <Circle radius="4" styleClass="status-dot"/>
                                <Label text="IA active · Réponse instantanée" styleClass="status-text"/>
                            </HBox>
                        </VBox>

                        <!-- Messages -->
                        <ScrollPane fitToWidth="true" styleClass="chatbot-messages-modern" VBox.vgrow="ALWAYS">
                            <VBox spacing="18">
                                <padding><Insets top="20" bottom="20" left="16" right="16"/></padding>

                                <!-- Message bot -->
                                <HBox spacing="10" alignment="TOP_LEFT">
                                    <StackPane styleClass="msg-avatar-bot">
                                        <FontAwesomeIconView glyphName="COMMENT" size="10"/>
                                    </StackPane>
                                    <VBox styleClass="msg-bubble-modern, bot" maxWidth="240">
                                        <Label text="Bonjour Ahmed ! 🌱" styleClass="msg-text"/>
                                        <Label text="Je vois que la parcelle P-002 nécessite votre attention. Des signes de mildiou ont été détectés." styleClass="msg-text" wrapText="true"/>
                                        <HBox spacing="8" alignment="CENTER_RIGHT">
                                            <Label text="11:32" styleClass="msg-time"/>
                                        </HBox>
                                    </VBox>
                                </HBox>

                                <!-- Message user -->
                                <HBox spacing="10" alignment="TOP_RIGHT">
                                    <VBox styleClass="msg-bubble-modern, user" maxWidth="240">
                                        <Label text="Que me recommandes-tu comme traitement ?" styleClass="msg-text"/>
                                        <HBox spacing="8" alignment="CENTER_RIGHT">
                                            <Label text="11:32" styleClass="msg-time"/>
                                        </HBox>
                                    </VBox>
                                    <StackPane styleClass="msg-avatar-user">
                                        <FontAwesomeIconView glyphName="USER" size="10"/>
                                    </StackPane>
                                </HBox>

                                <!-- Message bot avec actions -->
                                <HBox spacing="10" alignment="TOP_LEFT">
                                    <StackPane styleClass="msg-avatar-bot">
                                        <FontAwesomeIconView glyphName="COMMENT" size="10"/>
                                    </StackPane>
                                    <VBox styleClass="msg-bubble-modern, bot" maxWidth="240" spacing="12">
                                        <Label text="Je recommande un traitement fongicide préventif. Souhaitez-vous que je programme une pulvérisation ?" styleClass="msg-text" wrapText="true"/>
                                        <HBox spacing="10">
                                            <Button text="✅ Confirmer" styleClass="chatbot-btn-modern, primary"/>
                                            <Button text="⏰ Plus tard" styleClass="chatbot-btn-modern, secondary"/>
                                        </HBox>
                                        <Label text="11:33" styleClass="msg-time"/>
                                    </VBox>
                                </HBox>

